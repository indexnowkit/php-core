{
    "name": "indexnowkit/core",
    "description": "Framework-agnostic IndexNow client for PHP: batching, debounce, retry policy, key handling. Notify Yandex, Bing, Naver, Seznam and Yep about changed URLs.",
    "type": "library",
    "license": "MIT",
    "keywords": ["indexnow", "seo", "yandex", "bing", "naver", "seznam", "search-engine", "sitemap", "psr-18"],
    "homepage": "https://indexnowkit.dev",
    "require": {
        "php": "^8.2",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^2.0 || ^3.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0",
        "psr/clock": "^1.0",
        "php-http/discovery": "^1.20"
    },
    "suggest": {
        "symfony/http-client": "PSR-18 client (with nyholm/psr7) used by default discovery",
        "guzzlehttp/guzzle": "Alternative PSR-18 client",
        "symfony/property-access": "Property-path support in #[IndexNow(params: ...)]"
    },
    "autoload": {
        "psr-4": {"IndexNowKit\\": "src/"}
    },
    "config": {
        "allow-plugins": {"php-http/discovery": false}
    },
    "extra": {
        "branch-alias": {"dev-main": "0.1-dev"}
    }
}
